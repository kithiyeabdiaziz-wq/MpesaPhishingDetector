<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="SMS Detection"
            android:textColor="@color/primary_dark"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="Paste the suspicious M-Pesa message below for AI analysis."
            android:textColor="@color/text_secondary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Message Content"
            android:textColor="@color/text_dark"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/etSmsInput"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:background="@color/bg_card"
            android:padding="12dp"
            android:gravity="top|start"
            android:hint="Paste message here..."
            android:inputType="textMultiLine"
            android:layout_marginBottom="24dp"/>

        <Button
            android:id="@+id/btnAnalyzeSms"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="ANALYZE SMS"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:backgroundTint="@color/primary_dark"
            android:layout_marginBottom="24dp"/>

        <ProgressBar
            android:id="@+id/progressBarSms"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>